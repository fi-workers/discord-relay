# Copy to .env (local) or set as platform env vars. Never commit real values.

# ── Choose ONE delivery mode ──

# Mode A — Webhook (simplest; one webhook URL per channel):
DISCORD_SENTRY_WEBHOOK=
DISCORD_DEPLOY_WEBHOOK=

# Mode B — Bot (one token, many channels; stateless REST, fine on serverless).
# If DISCORD_BOT_TOKEN is set it takes precedence over the webhook URLs above.
# DISCORD_BOT_TOKEN=
# DISCORD_SENTRY_CHANNEL_ID=
# DISCORD_DEPLOY_CHANNEL_ID=

# ── Optional: enable HMAC signature verification when set ──
SENTRY_SECRET=
VERCEL_SECRET=
